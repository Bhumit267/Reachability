FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=cve_commander

# LLM Provider Configuration:
# Option 1: Ollama (Local, 100% Free, NO API Key needed)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1

# Option 2: Anthropic Claude (Cloud, API key from https://console.anthropic.com)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-sonnet-latest
# LLM_API_KEY=sk-ant-api...
# LLM_BASE_URL=

# Option 3: Groq (Cloud, 100% Free tier, API key from https://console.groq.com)
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Option 4: Google Gemini (Cloud, 100% Free tier, API key from https://aistudio.google.com)
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-1.5-flash
# LLM_API_KEY=AIzaSy...
# LLM_BASE_URL=
