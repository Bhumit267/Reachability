FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=cve_commander

# Option 1: Ollama Cloud (Free plan with gemma4:31b-cloud, https://ollama.com)
LLM_PROVIDER=ollama_cloud
LLM_MODEL=gemma4:31b-cloud
LLM_API_KEY=your_ollama_cloud_api_key_here
LLM_BASE_URL=https://ollama.com/v1

# Option 2: Local Ollama (100% Free local instance, http://localhost:11434)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1

# Option 3: Groq Cloud (Free tier, https://console.groq.com)
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
